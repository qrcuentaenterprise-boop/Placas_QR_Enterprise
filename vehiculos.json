import pandas as pd
import json

# 1. Cargar el inventario
df = pd.read_excel('Full inventory; Actualizaciones.xlsx')

cols_map = {
    'Sucursal  ': 'Sucursal',
    'Ubicación Actual': 'Ubicacion_Actual',
    'N.º Unid. ': 'No_Unidad',
    'Año': 'Ano',
    'Modelo': 'Modelo',
    'Carrocería': 'Carroceria',
    'Color': 'Color',
    'Placa': 'Placa',
    'Kilómetros': 'Kilometros',
    'Estado': 'Estado',
    'Últ. Arrend.': 'Ult_Arrendamiento',
    'dia inactivo': 'Dia_Inactivo',
    'Dia de hoy': 'Dia_Hoy'
}

df_clean = df[list(cols_map.keys())].rename(columns=cols_map)

# 2. Formatear fechas y limpiar nulos
for col in df_clean.columns:
    if pd.api.types.is_datetime64_any_dtype(df_clean[col]):
        df_clean[col] = df_clean[col].dt.strftime('%Y-%m-%d')

df_clean = df_clean.fillna('N/A')

# 3. Guardar archivo vehiculos.json en UTF-8 estricto
records = df_clean.to_dict(orient='records')
with open('vehiculos.json', 'w', encoding='utf-8') as f:
    json.dump(records, f, ensure_ascii=False, indent=2)

print("Archivo 'vehiculos.json' generado correctamente y listo para subir a GitHub.")
